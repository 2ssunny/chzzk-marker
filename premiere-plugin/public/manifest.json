{
  "manifestVersion": 5,
  "id": "com.chzzk-edit-marker.premiere",
  "name": "CHZZK Marker Import",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "chzzkMarkerImport",
      "label": { "default": "CHZZK Marker Import" },
      "minimumSize": { "width": 260, "height": 360 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 320, "height": 600 },
      "preferredFloatingSize": { "width": 360, "height": 640 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/icon.svg", "scale": [1, 2], "theme": ["all"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/icon.svg", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
